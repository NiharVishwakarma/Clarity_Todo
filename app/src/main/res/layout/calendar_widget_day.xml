<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_day_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical"
    android:contentDescription="Calendar date">
    <FrameLayout android:layout_width="28dp" android:layout_height="24dp" android:layout_gravity="center">
        <ImageView android:id="@+id/calendar_selected_circle" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/calendar_selected_circle" android:scaleType="fitXY" android:visibility="gone" />
        <TextView android:id="@+id/calendar_day_number" android:layout_width="match_parent" android:layout_height="match_parent" android:fontFamily="@font/nunito" android:gravity="center" android:includeFontPadding="false" android:text="1" android:textSize="15sp" />
    </FrameLayout>
    <ImageView android:id="@+id/calendar_status_dot" android:layout_width="4dp" android:layout_height="4dp" android:layout_marginTop="1dp" android:src="@drawable/calendar_status_dot" android:visibility="gone" />
</LinearLayout>
