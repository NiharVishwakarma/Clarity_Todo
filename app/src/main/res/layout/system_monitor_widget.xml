<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/system_monitor_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/monitor_widget_info"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="System Monitor · Info"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/monitor_widget_refresh"
            android:layout_width="64dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:contentDescription="Refresh system metrics"
            android:text="Refresh"
            android:textColor="#FF8A96"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/monitor_widget_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Device model · Unavailable"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/monitor_widget_ram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Available RAM: Unavailable"
        android:textColor="#DDDEE5"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/monitor_widget_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:contentDescription="Open storage settings"
        android:text="Storage: Unavailable"
        android:textColor="#DDDEE5"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/monitor_widget_battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:contentDescription="Open battery settings"
        android:text="Battery: Unavailable"
        android:textColor="#DDDEE5"
        android:textSize="12sp" />
    <LinearLayout
        android:id="@+id/monitor_widget_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/monitor_widget_android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Android: Unavailable"
            android:textColor="#DDDEE5"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/monitor_widget_security"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Security patch: Unavailable"
            android:textColor="#DDDEE5"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/monitor_widget_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Not updated · Tap Refresh"
            android:textColor="#B9BBC8"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/monitor_widget_downloads"
            android:layout_width="70dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="Downloads"
            android:textColor="#FF8A96"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
