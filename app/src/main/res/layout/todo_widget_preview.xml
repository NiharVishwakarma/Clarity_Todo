<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_outer_background" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:padding="8dp">
        <FrameLayout android:layout_width="58dp" android:layout_height="match_parent">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_count_background" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="5" android:textColor="#FFFFFF" android:textSize="24sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Tasks" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_task_card_background" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp">
                <TextView android:layout_width="36dp" android:layout_height="26dp" android:layout_gravity="end" android:gravity="center" android:fontFamily="sans-serif-medium" android:text="↻" android:textColor="#F20D24" android:textSize="17sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="20dp" android:layout_height="match_parent" android:gravity="center" android:text="✓" android:textColor="#35D07F" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="Morning Workout" android:textColor="#8A8A8A" android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="20dp" android:layout_height="match_parent" android:gravity="center" android:text="●" android:textColor="#FFC857" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="Team Meeting 10:00" android:textColor="#F5F5F5" android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="20dp" android:layout_height="match_parent" android:gravity="center" android:text="○" android:textColor="#D7D7D7" android:textSize="13sp" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="Buy Groceries" android:textColor="#F5F5F5" android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="20dp" android:layout_height="match_parent" android:gravity="center" android:text="○" android:textColor="#D7D7D7" android:textSize="13sp" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="Review Project Proposal" android:textColor="#F5F5F5" android:textSize="11sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="20dp" android:layout_height="match_parent" android:gravity="center" android:text="○" android:textColor="#D7D7D7" android:textSize="13sp" />
                        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:fontFamily="sans-serif-medium" android:maxLines="1" android:text="Call Parents" android:textColor="#F5F5F5" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="36dp" android:layout_height="26dp" android:layout_gravity="end" android:gravity="center" android:fontFamily="sans-serif-medium" android:text="+" android:textColor="#F20D24" android:textSize="22sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
