<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_outer_background" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:padding="8dp">
        <FrameLayout android:layout_width="58dp" android:layout_height="match_parent">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_count_background" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/nunito" android:text="2" android:textColor="#FFFFFF" android:textSize="22sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/nunito" android:text="Tasks" android:textColor="#FFFFFF" android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_task_card_background" android:scaleType="fitXY" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:layout_width="48dp" android:layout_height="32dp" android:layout_gravity="end" android:gravity="center" android:fontFamily="@font/nunito" android:text="↻" android:textColor="#F20D24" android:textSize="18sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:fontFamily="@font/nunito" android:text="  ◯  Sleep" android:textColor="#F5F5F5" android:textSize="15sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:fontFamily="@font/nunito" android:text="  ●  awake" android:textColor="#8A8A8A" android:textSize="14sp" />
                </LinearLayout>
                <TextView android:layout_width="48dp" android:layout_height="32dp" android:layout_gravity="end" android:gravity="center" android:fontFamily="@font/nunito" android:text="+" android:textColor="#F20D24" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
