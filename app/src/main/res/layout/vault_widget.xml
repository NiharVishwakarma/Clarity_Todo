<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vault_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:contentDescription="@string/vault_widget_locked_content_description">
    <ImageView
        android:id="@+id/vault_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/vault_widget_background"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">
        <ImageView
            android:id="@+id/vault_widget_icon"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:adjustViewBounds="true"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/clarity_suite_icon"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/vault_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/vault_widget_label"
                android:textColor="#FFF4F3F5"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1" />
            <ImageView
                android:id="@+id/vault_widget_title_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:visibility="gone" />
            <TextView
                android:id="@+id/vault_widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/vault_widget_locked_status"
                android:textColor="#FFAAA8B0"
                android:textSize="12sp"
                android:maxLines="1" />
            <ImageView
                android:id="@+id/vault_widget_status_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
