<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallpaper_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vault_widget_background"
    android:contentDescription="@string/wallpaper_widget_content_description">
    <ImageView
        android:id="@+id/wallpaper_widget_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_widget_preview"
        android:contentDescription="@string/wallpaper_widget_preview_description" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#990D0D10" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">
        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@mipmap/ic_clarity_suite"
            android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wallpaper_widget_title"
                android:textColor="#FFF4F3F5"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />
            <TextView
                android:id="@+id/wallpaper_widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/wallpaper_widget_status_default"
                android:textColor="#FFDEDAE2"
                android:textSize="11sp"
                android:maxLines="1" />
            <ProgressBar
                android:id="@+id/wallpaper_widget_loading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>
        <Button
            android:id="@+id/wallpaper_widget_action"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FFF20D24"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/wallpaper_widget_action"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
